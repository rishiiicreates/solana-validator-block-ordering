# Solana RPC endpoint (defaults to public mainnet or devnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Target validator identity public key (optional, will auto-detect from leader schedule if omitted)
SOLANA_VALIDATOR_PUBKEY=

# Maximum spend cap in SOL for any active probing operations (safety invariant)
SOLANA_SPEND_CAP=0.0

# Number of sample slots to collect
SOLANA_SAMPLE_COUNT=5

# Run in dry run mode (no network requests if mock enabled, or strictly read-only RPC)
DRY_RUN=false
